.DS_Store
__pycache__/
*.py[cod]
*.pt
*.engine
*.tar
*.tar.gz
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ultralytics/
.venv/
venv/
env/
dist/
build/
*.egg-info/
wandb/

# Large local data and experiment outputs.
data/raw/*
data/processed/*
runs/**
!runs/**/
reports/figures/*
reports/calibration/**
!reports/calibration/**/
reports/pareto*
!reports/empty_tile_rates.json
!reports/positive_rates.json

!.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!runs/.gitkeep
!reports/.gitkeep

# Overleaf upload bundle, rebuilt on demand from paper/
paper/overleaf_upload.zip

# LaTeX build artifacts
paper/main.pdf
paper/main.log
paper/main.blg
paper/main.aux
paper/main.out
paper/main.bbl

# summary memo build artifacts
docs/*.log
docs/*.aux
docs/*.out

# Training logs are large, machine-specific and mostly progress-bar output.
# Kept locally, never published.
logs/

# Manuscript sources and build products. Kept locally, never published.
paper/

# Small derived artifacts needed to regenerate the manuscript's tables without
# the datasets or the checkpoints. The bulky siblings stay ignored above.
!reports/calibration/**
!reports/calibration/**/*/reliability_summary.json
!runs/**/history.json
!runs/**/results.csv

# The reliability plots are regenerated by scripts/paper_figures.py; only the
# summaries they are drawn from need to be tracked.
reports/calibration/**/reliability.pdf
reports/calibration/**/reliability.png

# Test suite. Kept locally, not published.
tests/

# Submitted manuscript snapshot (round-1 baseline for latexdiff); never edited
paper_r0_submitted/

# Round-1 revision results: the JSON results behind every number are tracked;
# figures are regenerated by script, logs stay local, and the HRSC2016 contact
# sheet holds third-party imagery.
reports/r1/figures/
reports/r1/logs/
reports/r1/hrsc_negatives/
reports/r1/tap_scores_smoke/
reports/r1/**/*.log
runs/r1_debug/
runs/r1_tap/*_smoke/
